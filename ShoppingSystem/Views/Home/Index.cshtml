@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Shopping system &mdash; registration of orders.</p>
</div>

<div class="row row-cols-1 row-cols-md-2 g-3 mt-3">
    <div class="col">
        <div class="card h-100"><div class="card-body">
            <h5 class="card-title">Customers</h5>
            <p class="card-text">Search, sort and manage customers.</p>
            <a class="btn btn-outline-primary" asp-controller="Customers" asp-action="Index">Open</a>
        </div></div>
    </div>
    <div class="col">
        <div class="card h-100"><div class="card-body">
            <h5 class="card-title">Products</h5>
            <p class="card-text">Product catalogue with prices.</p>
            <a class="btn btn-outline-primary" asp-controller="Products" asp-action="Index">Open</a>
        </div></div>
    </div>
    <div class="col">
        <div class="card h-100"><div class="card-body">
            <h5 class="card-title">Supermarkets</h5>
            <p class="card-text">Stores where orders are placed.</p>
            <a class="btn btn-outline-primary" asp-controller="Supermarkets" asp-action="Index">Open</a>
        </div></div>
    </div>
    <div class="col">
        <div class="card h-100"><div class="card-body">
            <h5 class="card-title">Orders</h5>
            <p class="card-text">Create orders, add products, see the total cost.</p>
            <a class="btn btn-outline-primary" asp-controller="Orders" asp-action="Index">Open</a>
        </div></div>
    </div>
</div>
