@model ShoppingSystem.Models.ViewModels.OrderIndexData

@{
    ViewData["Title"] = "Orders";
    var selectedId = ViewData["OrderId"] as int?;
}

<h1>Orders</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>OrderDate</th>
            <th>Customer</th>
            <th>SuperMarket</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Orders)
{
        <tr class="@(item.Id == selectedId ? "table-success" : null)">
            <td>@Html.DisplayFor(modelItem => item.OrderDate)</td>
            <td>@item.Customer?.FullName</td>
            <td>@item.SuperMarket?.Name</td>
            <td class="text-end">
                <a asp-action="Index" asp-route-id="@item.Id">Select</a> |
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

@if (Model.SelectedOrder != null)
{
    var order = Model.SelectedOrder;
    <h3 class="mt-4">Order Details</h3>
    <p class="text-muted">
        @order.OrderDate.ToString("yyyy-MM-dd") &middot; @order.Customer?.FullName &middot; @order.SuperMarket?.Name
    </p>
    <p>
        <a asp-controller="OrderDetails" asp-action="Create" asp-route-orderId="@order.Id">Add product</a>
    </p>

    @if (order.OrderDetails.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Quantity</th>
                    <th class="text-end">Price</th>
                    <th class="text-end">Cost</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var detail in order.OrderDetails.OrderBy(d => d.Product?.Name))
            {
                <tr>
                    <td>@detail.Product?.Name</td>
                    <td>@detail.Quantity</td>
                    <td class="text-end">@detail.Product?.Price.ToString("0.00")</td>
                    <td class="text-end">@detail.Cost.ToString("0.00")</td>
                    <td class="text-end">
                        <a asp-controller="OrderDetails" asp-action="Edit" asp-route-id="@detail.ID">Edit</a> |
                        <a asp-controller="OrderDetails" asp-action="Delete" asp-route-id="@detail.ID">Delete</a>
                    </td>
                </tr>
            }
            </tbody>
            <tfoot>
                <tr class="fw-bold">
                    <td colspan="3">Total</td>
                    <td class="text-end">@order.Total.ToString("0.00")</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    }
    else
    {
        <p>This order has no products yet.</p>
    }
}
