@model ShoppingSystem.Models.Order

<dl class="row">
    <dt class="col-sm-2">OrderDate</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.OrderDate)</dd>
    <dt class="col-sm-2">Customer</dt>
    <dd class="col-sm-10">@Model.Customer?.FullName</dd>
    <dt class="col-sm-2">SuperMarket</dt>
    <dd class="col-sm-10">@Model.SuperMarket?.Name (@Model.SuperMarket?.Address)</dd>
</dl>

<table class="table">
    <thead>
        <tr>
            <th>Product</th>
            <th>Quantity</th>
            <th class="text-end">Price</th>
            <th class="text-end">Cost</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var detail in Model.OrderDetails.OrderBy(d => d.Product?.Name))
    {
        <tr>
            <td>@detail.Product?.Name</td>
            <td>@detail.Quantity</td>
            <td class="text-end">@detail.Product?.Price.ToString("0.00")</td>
            <td class="text-end">@detail.Cost.ToString("0.00")</td>
        </tr>
    }
    </tbody>
    <tfoot>
        <tr class="fw-bold">
            <td colspan="3">Total</td>
            <td class="text-end">@Model.Total.ToString("0.00")</td>
        </tr>
    </tfoot>
</table>
