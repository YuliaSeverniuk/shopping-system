@model ShoppingSystem.Models.OrderDetail

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>
<h4>Order item</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <input type="hidden" asp-for="ID" />
            <partial name="_OrderDetailForm" model="Model" />
            <div class="form-group mt-3">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-controller="Orders" asp-action="Index" asp-route-id="@Model.OrderId">Back to order</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
