@model ShoppingSystem.Models.Customer

@{
    ViewData["Title"] = "Delete";
    var blockedMessage = ViewData["HasOrders"] as bool? == true ? "This customer has orders and cannot be deleted. Delete the orders first." : null;
}

<h1>Delete</h1>

@if (blockedMessage != null)
{
    <div class="alert alert-warning">@blockedMessage</div>
}
else
{
    <h3>Are you sure you want to delete this?</h3>
}
<div>
    <h4>Customer</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.LastName)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.LastName)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.FirstName)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.FirstName)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Address)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Address)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Discount)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Discount)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="ID" />
        @if (blockedMessage == null)
        {
            <input type="submit" value="Delete" class="btn btn-danger" />
            <text> | </text>
        }
        <a asp-action="Index">Back to List</a>
    </form>
</div>
